# Neon -> Dashboard -> Connection string (pooled recommended)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Long random string used to sign the session cookie (REQUIRED in production, min 16 chars):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me

# --- Optional: password reset emails (https://resend.com) ---
# Without these two, "Forgot password" reports that it isn't set up.
RESEND_API_KEY=
EMAIL_FROM=Roadly <no-reply@your-domain.com>

# Public site address used in emailed links. On Vercel it is picked up automatically
# from VERCEL_PROJECT_PRODUCTION_URL; set this if you use a custom domain.
SITE_URL=https://your-domain.com

# Shown on the privacy page so people can reach you (rights requests, image removal).
NEXT_PUBLIC_CONTACT_EMAIL=
